{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ctrlCctrlV",
  "identifier": "io.github.bigzet.ctrlcctrlv",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ctrlCctrlV",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
